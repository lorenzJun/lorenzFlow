<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LorenzFlow" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lf_accent</item>
        <item name="colorOnPrimary">@color/lf_on_accent</item>
        <item name="colorPrimaryContainer">@color/lf_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/lf_text_primary</item>
        <item name="colorSecondary">@color/lf_accent</item>
        <item name="colorOnSecondary">@color/lf_on_accent</item>
        <item name="colorSecondaryContainer">@color/lf_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/lf_text_primary</item>
        <item name="colorTertiary">#FF9F0A</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#624A00</item>
        <item name="colorOnTertiaryContainer">#FFDDB3</item>
        <item name="colorError">#FF453A</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#93000A</item>
        <item name="colorOnErrorContainer">#FFDAD6</item>
        <item name="android:colorBackground">@color/lf_background</item>
        <!-- Behind the transparent status bar → seamless edge-to-edge -->
        <item name="android:windowBackground">@color/lf_background</item>
        <item name="colorOnBackground">@color/lf_text_primary</item>
        <item name="colorSurface">@color/lf_surface</item>
        <item name="colorOnSurface">@color/lf_text_primary</item>
        <item name="colorSurfaceVariant">@color/lf_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/lf_text_secondary</item>
        <item name="colorOutline">@color/lf_hairline</item>
        <item name="colorOutlineVariant">@color/lf_hairline</item>
        <item name="colorSurfaceInverse">#F2F2F7</item>
        <item name="colorOnSurfaceInverse">#1C1C1E</item>

        <!-- Shape system: pill-shaped small components (chips, search bars,
             buttons), 24dp-rounded medium/large components (cards, sheets). -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.LF.Pill</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.LF.Corner24</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.LF.Corner24</item>

        <!-- Soft & airy status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/lf_surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Dialog overlay style — soft & airy -->
    <style name="Theme.LorenzFlow.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/lf_accent</item>
        <item name="colorSecondary">@color/lf_accent</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.LorenzFlow.Dialog.Body</item>
    </style>

    <style name="TextAppearance.LorenzFlow.Dialog.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

</resources>
