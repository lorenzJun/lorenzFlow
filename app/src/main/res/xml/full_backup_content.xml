<?xml version="1.0" encoding="utf-8"?>
<!--
    API 26-30 Auto Backup rules (fullBackupContent).
    Excludes the encrypted password vault so a restored copy of the app
    never contains ciphertext it cannot decrypt (AndroidKeyStore keys are
    device-bound and do not travel with backups).
-->
<full-backup-content>
    <exclude domain="database" path="lorenz_flow_db" />
    <exclude domain="database" path="lorenz_flow_db-wal" />
    <exclude domain="database" path="lorenz_flow_db-shm" />
</full-backup-content>
