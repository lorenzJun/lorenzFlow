<?xml version="1.0" encoding="utf-8"?>
<!-- Fully rounded (pill) search field background: soft variant surface,
     hairline outline, no shadow. Pair with lf_corner_pill if used in code. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/lf_surface_variant" />
    <stroke
        android:width="1dp"
        android:color="@color/lf_hairline" />
    <corners android:radius="@dimen/lf_corner_pill" />
</shape>
