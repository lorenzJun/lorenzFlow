<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LorenzFlow" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lf_accent</item>
        <item name="colorOnPrimary">@color/lf_on_accent</item>
        <item name="colorPrimaryContainer">@color/lf_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/lf_text_primary</item>
        <item name="colorSecondary">@color/lf_accent</item>
        <item name="colorOnSecondary">@color/lf_on_accent</item>
        <item name="colorSecondaryContainer">@color/lf_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/lf_text_primary</item>
        <item name="colorTertiary">#FF9500</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FFDDB3</item>
        <item name="colorOnTertiaryContainer">#2A1800</item>
        <item name="colorError">#FF3B30</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#FFDAD6</item>
        <item name="colorOnErrorContainer">#410002</item>
        <item name="android:colorBackground">@color/lf_background</item>
        <!-- Behind the transparent status bar → seamless edge-to-edge -->
        <item name="android:windowBackground">@color/lf_background</item>
        <item name="colorOnBackground">@color/lf_text_primary</item>
        <item name="colorSurface">@color/lf_surface</item>
        <item name="colorOnSurface">@color/lf_text_primary</item>
        <item name="colorSurfaceVariant">@color/lf_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/lf_text_secondary</item>
        <item name="colorOutline">@color/lf_hairline</item>
        <item name="colorOutlineVariant">@color/lf_hairline</item>
        <item name="colorSurfaceInverse">#2C2C2E</item>
        <item name="colorOnSurfaceInverse">#F2F2F7</item>

        <!-- Shape system: pill-shaped small components (chips, search
             bars, buttons), 24dp-rounded medium/large components (cards,
             sheets). -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.LF.Pill</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.LF.Corner24</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.LF.Corner24</item>

        <!-- Soft & airy status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/lf_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Dialog overlay style — iOS-inspired -->
    <style name="Theme.LorenzFlow.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/lf_accent</item>
        <item name="colorSecondary">@color/lf_accent</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.LorenzFlow.Dialog.Body</item>
    </style>

    <style name="TextAppearance.LorenzFlow.Dialog.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Soft & airy card — 24dp corners, no shadow, no stroke -->
    <style name="Widget.LorenzFlow.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/lf_corner_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- iOS-style bottom navigation -->
    <style name="Widget.LorenzFlow.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/lf_surface</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="itemTextColor">@color/lf_text_secondary</item>
        <item name="itemIconTint">@color/lf_text_secondary</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- iOS-style toolbar (large title feel) -->
    <style name="Widget.LorenzFlow.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.LorenzFlow.Toolbar.Title</item>
    </style>

    <style name="TextAppearance.LorenzFlow.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ==================== LF SHAPE APPEARANCES ==================== -->

    <!-- Fully rounded: chips, search bars, small buttons -->
    <style name="ShapeAppearance.LF.Pill" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 24dp cards, sheets, dialogs -->
    <style name="ShapeAppearance.LF.Corner24" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Fully circular (profile avatar) -->
    <style name="ShapeAppearance.LF.Circle" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <!-- ==================== LF TYPOGRAPHY ==================== -->

    <!-- Bold dark headings -->
    <style name="TextAppearance.LF.Heading" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lf_text_primary</item>
        <item name="lineHeight">28sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Medium-weight subheadings -->
    <style name="TextAppearance.LF.Subheading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lf_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Muted grey captions / secondary text -->
    <style name="TextAppearance.LF.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/lf_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ==================== LF BOTTOM NAV TYPOGRAPHY ====================
         Color comes from the bottom_nav_color selector (checked -> primary
         text, unchecked -> secondary grey); these styles only set weight. -->
    <style name="TextAppearance.LF.BottomNav" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Dark bold label for the active tab -->
    <style name="TextAppearance.LF.BottomNav.Active" parent="TextAppearance.LF.BottomNav">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Muted label for inactive tabs -->
    <style name="TextAppearance.LF.BottomNav.Inactive" parent="TextAppearance.LF.BottomNav">
        <item name="android:textStyle">normal</item>
    </style>

</resources>
