<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customize your session and break durations in minutes."
        android:textSize="14sp"
        android:textColor="@color/ios_secondary_label"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif"/>

    <!-- Focus Duration Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_focus_mins"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Focus Duration (minutes)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_focus_mins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:fontFamily="sans-serif"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Short Break Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_short_mins"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Short Break Duration (minutes)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_short_mins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:fontFamily="sans-serif"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Long Break Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_long_mins"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Long Break Duration (minutes)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_long_mins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:fontFamily="sans-serif"/>

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
