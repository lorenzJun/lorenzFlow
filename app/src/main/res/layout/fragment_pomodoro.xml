<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Mode Toggle Group (pill segment) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_group_modes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btn_mode_focus">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_focus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pomo_mode_focus"
                android:textSize="14sp"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_short"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pomo_mode_short"
                android:textSize="14sp"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_long"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pomo_mode_long"
                android:textSize="14sp"
                app:cornerRadius="24dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ==================== Big soft circular countdown ==================== -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="48dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/pomodoro_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:indicatorSize="280dp"
                app:trackThickness="20dp"
                app:indicatorColor="@color/lf_accent"
                app:trackColor="@color/lf_pastel_lilac"
                app:trackCornerRadius="10dp"
                android:progress="100"
                app:indicatorDirectionCircular="counterclockwise" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timer_placeholder"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    android:textColor="@color/lf_text_primary"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lf_spacing_sm"
                    android:text="@string/pomodoro_status_focus"
                    android:textSize="14sp"
                    android:textColor="@color/lf_text_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05" />

            </LinearLayout>

        </FrameLayout>

        <!-- ==================== Controls Row ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <!-- Reset Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:text="@string/reset_timer"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                android:textColor="@color/lf_text_primary"
                android:paddingHorizontal="24dp" />

            <!-- Start / Pause Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_pause"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/start"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/lf_accent"
                android:textColor="@color/lf_on_accent"
                android:paddingHorizontal="32dp" />

        </LinearLayout>

        <!-- Adjust Durations Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_change_durations"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/adjust_durations"
            app:icon="@drawable/ic_settings"
            android:textColor="@color/lf_accent"
            app:iconTint="@color/lf_accent" />

    </LinearLayout>

</ScrollView>
