<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Archive indicator icon -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_archive"
            app:tint="@color/ios_secondary_label"
            android:alpha="0.5"
            android:importantForAccessibility="no"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_archived_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:fontFamily="sans-serif"
                android:alpha="0.75" />

            <TextView
                android:id="@+id/text_archived_task_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ios_secondary_label"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_archived_task_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/badge_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Restore button -->
        <ImageButton
            android:id="@+id/btn_restore_task"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_unarchive"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/ios_blue"
            android:contentDescription="@string/unarchive"
            android:layout_marginStart="8dp" />

        <!-- Delete button -->
        <ImageButton
            android:id="@+id/btn_delete_archived_task"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/ios_secondary_label"
            android:contentDescription="@string/delete"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
