<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lf_background">

    <!-- ==================== Header ==================== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lf_spacing_sm"
        android:paddingHorizontal="@dimen/lf_screen_padding"
        android:text="@string/calendar_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/lf_text_primary" />

    <TextView
        android:id="@+id/text_selected_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="@dimen/lf_screen_padding"
        android:layout_marginEnd="@dimen/lf_screen_padding"
        android:text="@string/tasks_due_today"
        android:textAppearance="@style/TextAppearance.LF.Caption"
        android:textSize="13sp" />

    <!-- ==================== Interactive Calendar (24dp card) ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/lf_screen_padding"
        android:layout_marginTop="@dimen/lf_spacing_md"
        app:cardCornerRadius="@dimen/lf_corner_card"
        app:cardElevation="0dp"
        app:strokeColor="@color/lf_hairline"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <CalendarView
            android:id="@+id/calendar_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tasks RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_calendar_tasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/lf_screen_padding"
            android:paddingTop="@dimen/lf_spacing_sm"
            android:paddingBottom="24dp" />

        <!-- Empty state layout -->
        <LinearLayout
            android:id="@+id/empty_state_calendar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_calendar"
                android:alpha="0.25"
                app:tint="@color/lf_text_secondary"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/no_tasks_due_day"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.LF.Caption"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
