<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/lf_spacing_md"
    app:cardCornerRadius="@dimen/lf_corner_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/lf_hairline"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="?attr/colorSurface"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Row: Icon Badge, Title & Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Colored icon badge -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/icon_badge_background"
                android:backgroundTint="@color/lf_pastel_mint_deep"
                android:padding="8dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/white"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/text_password_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/lf_text_primary"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- Delete Action -->
            <ImageButton
                android:id="@+id/btn_delete_password"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorError"
                android:contentDescription="@string/cd_delete_saved_password" />

        </LinearLayout>

        <!-- Hairline divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/lf_spacing_md"
            android:layout_marginBottom="@dimen/lf_spacing_md"
            android:background="@color/lf_hairline" />

        <!-- Username Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/lf_spacing_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pm_username_label"
                    android:textSize="10sp"
                    android:textColor="@color/lf_text_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/text_password_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/lf_text_primary"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_copy_username"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_copy"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/lf_accent"
                android:contentDescription="@string/cd_copy_username"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Password Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pm_password_label"
                    android:textSize="10sp"
                    android:textColor="@color/lf_text_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/text_password_val"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pm_password_dots"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/lf_text_primary"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- Visibility Toggle -->
            <ImageButton
                android:id="@+id/btn_toggle_visibility"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_visibility"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/lf_text_secondary"
                android:contentDescription="@string/cd_toggle_password_visibility" />

            <!-- Copy Password -->
            <ImageButton
                android:id="@+id/btn_copy_password"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_copy"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/lf_accent"
                android:contentDescription="@string/cd_copy_password"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
