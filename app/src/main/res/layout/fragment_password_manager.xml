<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ==================== Header ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lf_spacing_sm"
            android:paddingHorizontal="@dimen/lf_screen_padding"
            android:text="@string/pm_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/lf_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="@dimen/lf_screen_padding"
            android:text="@string/pm_subtitle"
            android:textSize="13sp"
            android:textColor="@color/lf_text_secondary" />

        <!-- ==================== Pill search bar ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/lf_search_height"
            android:layout_marginHorizontal="@dimen/lf_screen_padding"
            android:layout_marginTop="@dimen/lf_spacing_md"
            android:background="@drawable/pill_search_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/lf_search_horizontal_padding">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/lf_text_secondary"
                android:importantForAccessibility="no" />

            <EditText
                android:id="@+id/edit_search_passwords"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:hint="@string/pm_search_hint"
                android:textColor="@color/lf_text_primary"
                android:textColorHint="@color/lf_text_secondary"
                android:textSize="15sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:maxLines="1"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <!-- ==================== List / empty state ==================== -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/empty_state_passwords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginTop="60dp"
                    android:padding="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_lock"
                        android:alpha="0.25"
                        app:tint="@color/lf_text_secondary"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/pm_empty_passwords"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextAppearance.LF.Caption"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- Passwords List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_passwords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/lf_screen_padding"
                    android:paddingTop="@dimen/lf_spacing_md"
                    android:paddingBottom="80dp"
                    android:clipToPadding="false" />

            </FrameLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Floating add button — solid accent, no shadow, pill corner -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/fab_add_password"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/lf_screen_padding"
        android:layout_marginBottom="@dimen/lf_screen_padding"
        android:elevation="0dp"
        android:text="+"
        android:textSize="28sp"
        android:textColor="@color/lf_on_accent"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        app:backgroundTint="@color/lf_accent"
        app:cornerRadius="30dp"
        style="@style/Widget.Material3.Button.UnelevatedButton" />

</FrameLayout>
