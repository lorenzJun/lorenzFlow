<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/archive_notes_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            android:elevation="2dp"
            app:title="@string/view_archive"
            app:navigationIcon="@drawable/ic_expand_less"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/archive_notes_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="48dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_archive"
                android:alpha="0.3"
                app:tint="@color/ios_secondary_label"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/no_archived_notes"
                android:textAlignment="center"
                android:textColor="@color/ios_secondary_label"
                android:textSize="15sp"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <!-- Archived notes grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_archived_notes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="@dimen/note_grid_spacing"
            android:paddingBottom="100dp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
