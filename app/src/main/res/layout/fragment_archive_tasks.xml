<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar — transparent over lf_background, no shadow -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/archive_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/lf_background"
            android:elevation="0dp"
            app:title="@string/view_archive"
            app:navigationIcon="@drawable/ic_expand_less"
            app:titleTextAppearance="@style/TextAppearance.LorenzFlow.Toolbar.Title" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/archive_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="100dp">

                <!-- Header row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/lf_screen_padding"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/archived_tasks"
                        android:textAppearance="@style/TextAppearance.LF.Heading" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_archive"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clear_archive"
                        android:textColor="?attr/colorError"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/archive_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="48dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_archive"
                        android:alpha="0.3"
                        app:tint="@color/lf_text_secondary"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/no_archived_tasks"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextAppearance.LF.Caption" />

                </LinearLayout>

                <!-- Archived tasks list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_archived_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/lf_screen_padding"
                    android:paddingTop="@dimen/lf_spacing_sm" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</FrameLayout>
