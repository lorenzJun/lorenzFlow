<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_password_title"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="App or Website Name (e.g. Google)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_password_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:fontFamily="sans-serif"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Username Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_password_username"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Username or Email">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_password_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:fontFamily="sans-serif"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password Input with End Icon Toggle -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_password_val"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Password"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_password_val"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLines="1"
            android:fontFamily="sans-serif"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Generate Password Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_generate_password"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Generate Strong Password"
        app:icon="@drawable/ic_settings"
        android:textColor="@color/ios_green"
        app:iconTint="@color/ios_green"
        app:cornerRadius="8dp" />

</LinearLayout>
